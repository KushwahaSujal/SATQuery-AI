# Copy to deploy/.env.modal (gitignored) and fill in. Read at `modal deploy` time.
SATQUERY_API_KEYS=make-a-long-random-key
DATABASE_URL=postgresql+asyncpg://...pooler.supabase.com:6543/postgres
GEMINI_API_KEY=
NVIDIA_API_KEY=
SATQUERY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Vercel names every deployment <project>-<hash>-<org>.vercel.app, so a fixed list
# would cover only the production alias. Scoped to this project on purpose: a bare
# https://.*\.vercel\.app would let any Vercel-hosted site call this backend with
# credentials. Measured: the production alias is satquery-ai-smoky.vercel.app but each
# deployment gets satquery-<hash>-<scope>.vercel.app -- Vercel truncates the project
# name there, so anchoring on "satquery-ai" would block every preview build.
SATQUERY_CORS_ORIGIN_REGEX=https://satquery[a-z0-9-]*\.vercel\.app
