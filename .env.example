# ==============================================================================
# SatQuery AI — Master Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real production passwords or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME [REQUIRED]
# ------------------------------------------------------------------------------
SATQUERY_ENV=development                # [REQUIRED] development | production | testing
SATQUERY_DEBUG=true                     # [OPTIONAL] Set to false in production
SATQUERY_HOST=0.0.0.0                   # [REQUIRED] Bind host
SATQUERY_PORT=8000                      # [REQUIRED] Backend FastAPI port
BACKEND_PORT=8000                       # [REQUIRED for Docker Compose]
FRONTEND_PORT=3000                      # [REQUIRED for Docker Compose]
SATQUERY_MAX_UPLOAD_MB=500              # [OPTIONAL] Max single upload size in MB

# ------------------------------------------------------------------------------
# 2. HARDWARE & COMPUTE ACCELERATION [REQUIRED]
# ------------------------------------------------------------------------------
SATQUERY_DEVICE=auto                    # [REQUIRED] auto | cuda | cpu
                                        # auto: Uses CUDA GPU if available, else CPU fallback.
                                        # cpu: Enforces CPU execution across all model adapters.

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + asyncpg) [REQUIRED]
# ------------------------------------------------------------------------------
# In Docker Compose, the database host is 'postgres'. On local machine, use 'localhost'.
POSTGRES_USER=satquery                  # [REQUIRED] PostgreSQL username
POSTGRES_PASSWORD=satquery              # [REQUIRED] PostgreSQL password (CHANGE IN PROD!)
POSTGRES_HOST=postgres                  # [REQUIRED] Hostname ('postgres' in Docker, 'localhost' on host)
POSTGRES_PORT=5432                      # [REQUIRED] PostgreSQL port
POSTGRES_DB=satquery                    # [REQUIRED] Target database name

# Async Database Connection URL
DATABASE_URL=postgresql+asyncpg://satquery:satquery@postgres:5432/satquery

# ------------------------------------------------------------------------------
# 4. FRONTEND NETWORKING & API BOUNDARIES [REQUIRED]
# ------------------------------------------------------------------------------
# BACKEND_API_URL: Server-side container URL used by Next.js server rewrites inside Docker
BACKEND_API_URL=http://backend:8000

# NEXT_PUBLIC_API_URL: Browser-facing URL accessed directly by the user's web browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. STORAGE, ARTIFACTS & WORKSPACE [REQUIRED]
# ------------------------------------------------------------------------------
SATQUERY_RESULTS_DIR=results            # [REQUIRED] Directory for uploaded rasters, masks & PDFs
CHECKPOINT_ROOT=checkpoints             # [REQUIRED] Directory containing local model weights
DATA_ROOT=datasets                      # [REQUIRED] Directory containing sample benchmark datasets

# ------------------------------------------------------------------------------
# 6. MODEL CHECKPOINTS (Relative to repository root or container mount)
# ------------------------------------------------------------------------------
GROUNDING_DINO_CHECKPOINT=checkpoints/grounding_dino/groundingdino_swint_ogc.pth
GROUNDING_DINO_CONFIG=checkpoints/grounding_dino/GroundingDINO_SwinT_OGC.py
SAM2_CHECKPOINT=checkpoints/sam2/sam2_hiera_base_plus.pt
SAM2_CONFIG=checkpoints/sam2/sam2_hiera_b+.yaml
CHANGEFORMER_CHECKPOINT=checkpoints/changeformer/satquery_changeformer_best.pt
CDVQA_CHECKPOINT=checkpoints/cdvqa/cdvqa_satquery.pt
DOFA_CHECKPOINT=checkpoints/dofa/DOFA_ViT_base_e100.pth
OPTICAL_SAR_FUSION_CHECKPOINT=checkpoints/optical_sar/satquery_fusion.pth
REMOTECLIP_CHECKPOINT=checkpoints/remoteclip/RemoteCLIP-ViT-B-32.pt
BIGEARTHNET_CHECKPOINT=checkpoints/bigearthnet/model.safetensors
GENERAL_RS_VLM_CHECKPOINT=checkpoints/general_rs_vlm
